# 复制这个文件为 keystore.properties（同目录），填入真实值。
#
#   copy keystore.properties.example keystore.properties
#
# keystore.properties 和 *.jks / *.keystore 已在 .gitignore 里，不会进版本库。
# 没有 keystore.properties 时，assembleRelease 会产出 app-release-unsigned.apk，
# 构建不会失败。

# 密钥库文件相对于项目根目录的路径
storeFile=smartschedule-release.jks

# 生成密钥库时设置的口令
storePassword=

# 生成时用 -alias 指定的别名
keyAlias=smartschedule

# 密钥口令（keytool 允许与 storePassword 相同）
keyPassword=
