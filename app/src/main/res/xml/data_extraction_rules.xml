<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 云备份 / 设备迁移规则 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="legal_consent.xml" />
        <exclude domain="sharedpref" path="weather_location.xml" />
        <include domain="file" path="." />
        <include domain="external" path="." />
        <exclude domain="external" path="downloads" />
        <exclude domain="file" path="crash.log" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="legal_consent.xml" />
        <exclude domain="sharedpref" path="weather_location.xml" />
        <include domain="file" path="." />
        <include domain="external" path="." />
        <exclude domain="external" path="downloads" />
    </device-transfer>
</data-extraction-rules>
