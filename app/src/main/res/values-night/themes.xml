<?xml version="1.0" encoding="utf-8"?>
<!--
  深色配色由 values-night/colors.xml 提供，这里只需要把系统栏图标翻成浅色。
-->
<resources>
    <style name="Theme.smartschedule" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/app_window_background</item>

        <item name="colorPrimary">@color/fluent_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/app_on_primary_container</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_on_surface_variant</item>
        <item name="colorOutline">@color/app_outline</item>
    </style>
</resources>
